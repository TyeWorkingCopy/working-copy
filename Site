<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Working Copy — Independent Graphic Design Studio</title>

  <meta name="description"
    content="Working Copy is an independent graphic design studio creating identities, campaigns and visual communications.">

  <style>

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: #f2f1ed;
      color: #111111;
      font-family: Arial, Helvetica, sans-serif;
      padding: 24px;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* HEADER */

    header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      font-size: 14px;
      text-transform: uppercase;
    }

    .logo {
      font-weight: 700;
    }

    nav {
      display: flex;
      gap: 24px;
    }

    /* HERO */

    .hero {
      min-height: 88vh;
      display: flex;
      align-items: flex-end;
      padding-bottom: 40px;
    }

    .hero h1 {
      font-size: clamp(54px, 9vw, 150px);
      line-height: 0.9;
      letter-spacing: -0.06em;
      font-weight: 500;
      max-width: 1400px;
    }

    /* SECTION */

    section {
      padding: 100px 0;
      border-top: 1px solid #111111;
    }

    .section-label {
      font-size: 13px;
      text-transform: uppercase;
      margin-bottom: 50px;
    }

    /* WORK */

    .project {
      margin-bottom: 100px;
    }

    .project-image {
      width: 100%;
      height: 70vh;
      background: #d8d7d2;
      margin-bottom: 16px;
    }

    .project-info {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      text-transform: uppercase;
    }

    /* SERVICES */

    .services {
      font-size: clamp(38px, 6vw, 90px);
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    /* ABOUT */

    .about-text {
      font-size: clamp(30px, 4vw, 64px);
      line-height: 1.08;
      letter-spacing: -0.035em;
      max-width: 1200px;
    }

    /* CONTACT */

    .contact {
      min-height: 70vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .contact h2 {
      font-size: clamp(55px, 10vw, 160px);
      line-height: 0.88;
      letter-spacing: -0.06em;
      font-weight: 500;
    }

    .email {
      font-size: clamp(22px, 3vw, 46px);
    }

    /* FOOTER */

    footer {
      border-top: 1px solid #111111;
      padding-top: 20px;
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      text-transform: uppercase;
    }

    /* MOBILE */

    @media (max-width: 700px) {

      body {
        padding: 16px;
      }

      nav {
        gap: 12px;
      }

      .hero {
        min-height: 80vh;
      }

      section {
        padding: 70px 0;
      }

      .project-image {
        height: 55vh;
      }

      .project-info {
        flex-direction: column;
        gap: 5px;
      }

      footer {
        flex-direction: column;
        gap: 8px;
      }

    }

  </style>
</head>


<body>


<header>

  <div class="logo">
    Working Copy
  </div>

  <nav>
    <a href="#work">Work</a>
    <a href="#about">Info</a>
    <a href="#contact">Contact</a>
  </nav>

</header>



<main>


  <section class="hero">

    <h1>
      Independent<br>
      graphic design<br>
      studio.
    </h1>

  </section>



  <section id="work">

    <div class="section-label">
      Selected Work
    </div>


    <article class="project">

      <div class="project-image"></div>

      <div class="project-info">
        <span>01 — Project Name</span>
        <span>Brand Identity</span>
        <span>2026</span>
      </div>

    </article>


    <article class="project">

      <div class="project-image"></div>

      <div class="project-info">
        <span>02 — Project Name</span>
        <span>Campaign / Event</span>
        <span>2026</span>
      </div>

    </article>


    <article class="project">

      <div class="project-image"></div>

      <div class="project-info">
        <span>03 — Project Name</span>
        <span>Graphic Design</span>
        <span>2026</span>
      </div>

    </article>

  </section>



  <section>

    <div class="section-label">
      What We Do
    </div>

    <div class="services">
      Brand Identity<br>
      Campaigns & Events<br>
      Ongoing Design Partnerships
    </div>

  </section>



  <section id="about">

    <div class="section-label">
      About
    </div>

    <p class="about-text">
      Working Copy is an independent graphic design studio creating
      identities, campaigns and visual communications for businesses,
      organisations and events.
    </p>

  </section>



  <section id="contact" class="contact">

    <h2>
      Have a project<br>
      in mind?
    </h2>

    <a class="email" href="mailto:hello@workingcopy.studio">
      hello@workingcopy.studio ↗
    </a>

  </section>


</main>



<footer>

  <span>Working Copy © 2026</span>

  <span>Folkestone, UK</span>

  <span>Independent Graphic Design Studio</span>

</footer>


</body>
</html>
